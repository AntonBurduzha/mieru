# Backend settings, read by mieru.core.config.Settings. Copy to .env (gitignored) and adjust.
ENV=local # local | test | prod
APP_BASE_URL=http://localhost:3000
INGEST_BASE_URL=http://localhost:8001

DATABASE_URL=postgresql+asyncpg://mieru:mieru@localhost:5432/mieru
REDIS_URL=redis://localhost:6379/0
CLICKHOUSE_URL=http://mieru:mieru@localhost:8123/mieru

SESSION_TTL_DAYS=30
SESSION_COOKIE_SECURE=false # true in prod
GEOIP_DB_PATH=data/dbip-country-lite.mmdb

WRITER_BATCH_MAX=5000
WRITER_FLUSH_MS=1000
STREAM_HIGH_WATER=200000
INGEST_FALLBACK_QUEUE=10000
LOADTEST_SECRET= # when empty, load-test header disabled

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
RESEND_API_KEY=
EMAIL_FROM=Mieru <hello@mieru.example>

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME= # ingest, api, writer, worker
GIT_SHA=dev
OTEL_TRACES_SAMPLER_RATIO=0.1
MIERU_VERSION=
WRITER_TEST_CRASH_AFTER_INSERT=false # refused when ENV=prod
