# Variables compose.prod.yaml reads on the server, from /srv/mieru/.env (mode 600, owner deploy).
# Names only: values never go into git. How to fill them: ops/README.md

# The image tag: the full commit sha of the checkout (git rev-parse HEAD), so the image and the config match
MIERU_TAG=
# The dashboard's host name. Ingest is in.<this>. Both need an A record (DNS only, no AAAA)
MIERU_DOMAIN=
# openssl rand -hex 32. Postgres applies its password only when its volume is first created
POSTGRES_PASSWORD=
# openssl rand -hex 32
CLICKHOUSE_PASSWORD=
# Let's Encrypt account: expiry and policy notices go here
ACME_EMAIL=
