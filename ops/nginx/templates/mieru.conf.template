# The two sites. At start, the nginx image writes this file to /etc/nginx/conf.d/mieru.conf
# with ${MIERU_DOMAIN} replaced by its value.

ssl_certificate /etc/letsencrypt/live/${MIERU_DOMAIN}/fullchain.pem;
ssl_certificate_key /etc/letsencrypt/live/${MIERU_DOMAIN}/privkey.pem;

# Passive health checks: a server that fails once is skipped for 5 s
upstream api {
    zone api 64k;
    server api:8000 resolve max_fails=1 fail_timeout=5s;
    keepalive 16;
}

upstream ingest {
    zone ingest 64k;
    server ingest-1:8001 resolve max_fails=1 fail_timeout=5s;
    server ingest-2:8001 resolve max_fails=1 fail_timeout=5s;
    keepalive 32;
}

# Any other host name: close the connection without an answer
server {
    listen 80 default_server;
    return 444;
}

server {
    listen 443 ssl default_server;
    ssl_reject_handshake on;
}

# Plain http: the ACME challenge for certbot, a redirect for everything else
server {
    listen 80;
    server_name ${MIERU_DOMAIN} in.${MIERU_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# The dashboard and its API
server {
    listen 443 ssl;
    http2 on;
    server_name ${MIERU_DOMAIN};

    access_log /var/log/nginx/access.log privacy;

    include /etc/nginx/snippets/headers.conf;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    include /etc/nginx/snippets/proxy.conf;

    location /api/ {
        proxy_pass http://api;
    }

    location = /health {
        proxy_pass http://api;
    }

    location = /health/ready {
        proxy_pass http://api;
    }

    # Until the web app is served from here (T20)
    location / {
        default_type text/plain;
        return 200 "Mieru is coming soon\n";
    }
}

# Ingest: called from every customer's site, so no access log at all
server {
    listen 443 ssl;
    http2 on;
    server_name in.${MIERU_DOMAIN};

    access_log off;

    include /etc/nginx/snippets/headers.conf;
    add_header Access-Control-Allow-Origin "*" always;
    include /etc/nginx/snippets/proxy.conf;

    location / {
        proxy_pass http://ingest;
    }
}

# Docker's healthcheck, reachable only from inside the container
server {
    listen 127.0.0.1:8080;
    access_log off;

    location = /healthz {
        default_type text/plain;
        return 200 "ok\n";
    }
}
