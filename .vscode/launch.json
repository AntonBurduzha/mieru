{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "api",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["--factory", "mieru.api.app:create_app", "--port", "8000"],
      "cwd": "${workspaceFolder}/apps/backend",
      "envFile": "${workspaceFolder}/.vscode/no-env-file",
      "python": "${workspaceFolder}/apps/backend/.venv/bin/python",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "ingest",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["--factory", "mieru.ingest.app:create_app", "--port", "8001"],
      "cwd": "${workspaceFolder}/apps/backend",
      "envFile": "${workspaceFolder}/.vscode/no-env-file",
      "python": "${workspaceFolder}/apps/backend/.venv/bin/python",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "pytest: current file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}"],
      "cwd": "${workspaceFolder}/apps/backend",
      "envFile": "${workspaceFolder}/.vscode/no-env-file",
      "python": "${workspaceFolder}/apps/backend/.venv/bin/python",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "pytest: -k",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-k", "${input:pytestK}"],
      "cwd": "${workspaceFolder}/apps/backend",
      "envFile": "${workspaceFolder}/.vscode/no-env-file",
      "python": "${workspaceFolder}/apps/backend/.venv/bin/python",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ],
  "inputs": [
    {
      "id": "pytestK",
      "type": "promptString",
      "description": "pytest -k expression, e.g. env_required or \"ttl and not zero\""
    }
  ]
}
